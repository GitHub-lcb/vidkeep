# ===========================================
# vidkeep 环境变量模板
# 使用方法：cp .env.example .env 然后修改
# 注意：.env 已在 .gitignore 中，不会被提交
# ===========================================

# ---- MySQL ----
# Docker Compose 中 mysql 容器使用 root 密码
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=vidkeep
# 后端连接数据库使用（本地开发同 root；容器内由 compose 覆盖为 mysql 服务名）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me-strong-password

# ---- Redis ----
# 注意：容器内由 compose 覆盖为 redis 服务名
# 本地开发需要 Redis >= 5.0（转码队列使用 Redis Stream），不满足时可用
# scripts/dev/start-redis-dev.ps1 启动便携 Redis（默认端口 6380）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT（登录令牌）----
# 生产环境务必替换为随机字符串，至少 32 位
JWT_SECRET=please-change-to-a-random-string-at-least-32-chars
JWT_EXPIRE_SECONDS=604800

# ---- 播放地址签名（P1 防盗链）----
# 播放地址带 expire + HMAC token，/hls 全链路校验并改写 m3u8
PLAY_TOKEN_SECRET=please-change-to-another-random-string
PLAY_TOKEN_EXPIRE_SECONDS=7200

# ---- 站点访问口令（P1，留空=不启用）----
# 设置后前台与 /api/public/**、/hls/**、/covers/** 需要先输入口令（管理员 JWT 不受影响）
SITE_ACCESS_PASSWORD=
SITE_TOKEN_SECRET=please-change-to-another-random-string
SITE_TOKEN_EXPIRE_SECONDS=2592000

# ---- 存储 ----
DATA_DIR=/data
# 单个视频文件上限
MAX_UPLOAD_SIZE=10GB

# ---- 转码 ----
# 并发转码数，建议 1；8 核以上可设 2
TRANSCODE_CONCURRENCY=1
# 本机未安装 FFmpeg 时可填绝对路径，例如：
# FFMPEG_PATH=E:/tools/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- 服务 ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
