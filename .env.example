# ===========================================
# vidkeep 环境变量模板
# 使用方法：cp .env.example .env 然后修改
# 注意：.env 已在 .gitignore 中，不会被提交
# ===========================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=vidkeep

# ---- JWT（登录令牌）----
# 生产环境务必替换为随机字符串，至少 32 位
JWT_SECRET=please-change-to-a-random-string-at-least-32-chars
JWT_EXPIRE_SECONDS=604800

# ---- 播放地址签名（P1 防盗链用）----
PLAY_TOKEN_SECRET=please-change-to-another-random-string
PLAY_TOKEN_EXPIRE_SECONDS=7200

# ---- 存储 ----
DATA_DIR=/data
# 单个视频文件上限
MAX_UPLOAD_SIZE=10GB

# ---- 转码 ----
# 并发转码数，建议 1；8 核以上可设 2
TRANSCODE_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- 服务 ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
